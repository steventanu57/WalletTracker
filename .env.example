# WalletTracker settings. Copy this file to .env (in the same folder) and fill in your own value.
# .env is ignored by git, so your token stays private. Restart the bot after a change.

# Your bot's token, from @BotFather in Telegram:
#   1. Open @BotFather and send /newbot.
#   2. Choose a display name, then a username that ends in "bot" (e.g. MyWalletTrackerBot).
#   3. BotFather replies with the token: a number, a colon and a long code, like 123456789:AAE...
# Anyone with the token can control your bot. If it leaks, get a new one with /revoke in @BotFather.
BOT_TOKEN=123456789:replace-with-your-bot-token

# The other settings (alert intervals, page sizes, limits) are at the top of wallet_tracker.py,
# under "SETTINGS YOU CAN CHANGE".
